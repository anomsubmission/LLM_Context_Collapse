paper/*.fls
paper/*.synctex.gz

# Manuscript is maintained in the separate Overleaf checkout
paper/
paper-local-backup/

# OS noise
.DS_Store

# Model weights and datasets are downloaded, never committed
*.safetensors
*.bin
!data/*.parquet
